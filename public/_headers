# Cloudflare Pages custom headers (static assets only; the Function sets its own headers).
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://tokenwatch.wyrdwerk.com https://openrouter.ai; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# JS defaults to max-age=14400 on Pages; align with the HTML/JSON default so a deploy is picked up on the next load.
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/engine.js
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
